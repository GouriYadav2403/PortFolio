# Backend Port
PORT=5000

# Environment: development | production
NODE_ENV=development

# Allowed Frontend Domain
FRONTEND_URL=http://localhost:3000

# MongoDB Connection String (Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/gouri_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/

# Nodemailer SMTP Configuration (e.g. Gmail App Password)
# For Gmail: Use smtp.gmail.com, port 587, your email, and a 16-character App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email Sender & Destination
MAIL_FROM=Gouri Yadav Portfolio <noreply@gouriyadav.dev>
MAIL_TO=gouriy2414@gmail.com
